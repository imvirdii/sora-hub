--------------------------------------------------
-- UPDATE BUTTONS
--------------------------------------------------

local function UpdateTrapButton()
	TrapButton.Text =
		"Trap: " .. (TrapEnabled and "ON" or "OFF")
end

local function UpdateTackleButton()
	TackleButton.Text =
		"Tackle: " .. (TackleEnabled and "ON" or "OFF")
end

local function UpdateAutoBikeButton()
	AutoBikeButton.Text =
		"Auto Bike: " .. (AutoBikeEnabled and "ON" or "OFF")
end

--------------------------------------------------
-- GUI BUTTONS
--------------------------------------------------

TrapButton.MouseButton1Click:Connect(function()
	TrapEnabled = not TrapEnabled
	UpdateTrapButton()
end)

TackleButton.MouseButton1Click:Connect(function()
	TackleEnabled = not TackleEnabled
	UpdateTackleButton()
end)

AutoBikeButton.MouseButton1Click:Connect(function()
	AutoBikeEnabled = not AutoBikeEnabled

	-- Cancel pending slot press
	AutoBikeArmed = false

	UpdateAutoBikeButton()
end)

--------------------------------------------------
-- KEYBOARD INPUT
--------------------------------------------------

UserInputService.InputBegan:Connect(function(Input, GameProcessed)

	if GameProcessed then
		return
	end

	--------------------------------------------------
	-- TRAP TOGGLE
	--------------------------------------------------

	if Input.KeyCode == Enum.KeyCode.F2 then
		TrapEnabled = not TrapEnabled
		UpdateTrapButton()
		return
	end

	--------------------------------------------------
	-- TACKLE TOGGLE
	--------------------------------------------------

	if Input.KeyCode == Enum.KeyCode.F3 then
		TackleEnabled = not TackleEnabled
		UpdateTackleButton()
		return
	end

	--------------------------------------------------
	-- AUTO BIKE TOGGLE
	--------------------------------------------------

	if Input.KeyCode == Enum.KeyCode.F4 then
		AutoBikeEnabled = not AutoBikeEnabled
		AutoBikeArmed = false

		UpdateAutoBikeButton()

		return
	end

	--------------------------------------------------
	-- AUTO BIKE
	--------------------------------------------------

	if not AutoBikeEnabled then
		return
	end

	local ImpactKey = GetImpactBicycleKey()

	--------------------------------------------------
	-- PRESS IMPACT BICYCLE SLOT
	--------------------------------------------------

	if ImpactKey
		and Input.KeyCode == ImpactKey then

		AutoBikeArmed = true

		return
	end

	--------------------------------------------------
	-- PRESS LMB
	--------------------------------------------------

	if Input.UserInputType == Enum.UserInputType.MouseButton1
		and AutoBikeArmed then

		AutoBikeArmed = false

		UseImpactBicycle()
	end
end)

--------------------------------------------------
-- IFRAME CHECK
--------------------------------------------------

local function HasIFrames(Character)

	if not Character then
		return false
	end

	return Character:FindFirstChild("IFrames") ~= nil
		or Character:FindFirstChild("SuperIFrames") ~= nil
end

--------------------------------------------------
-- TRAP SYSTEM
--------------------------------------------------

Transceiver.OnClientEvent:Connect(function(
	Action,
	Player,
	Style,
	Skill,
	Ball
)

	if not TrapEnabled then
		return
	end

	if Action ~= "Hold" then
		return
	end

	if Player == LocalPlayer then
		return
	end

	if Skill ~= "Impact Shot"
		and Skill ~= "Explosive Kick" then
		return
	end

	--------------------------------------------------
	-- COOLDOWN
	--------------------------------------------------

	local Now = tick()

	if Now - LastTrigger < TrapCooldown then
		return
	end

	--------------------------------------------------
	-- LOCAL CHARACTER
	--------------------------------------------------

	local Character = LocalPlayer.Character

	if not Character then
		return
	end

	local LocalRoot =
		Character:FindFirstChild("HumanoidRootPart")

	if not LocalRoot then
		return
	end

	--------------------------------------------------
	-- ENEMY CHARACTER
	--------------------------------------------------

	local EnemyCharacter = Player.Character

	if not EnemyCharacter then
		return
	end

	local EnemyRoot =
		EnemyCharacter:FindFirstChild("HumanoidRootPart")

	if not EnemyRoot then
		return
	end

	--------------------------------------------------
	-- IFRAME CHECK
	--------------------------------------------------

	if HasIFrames(Character) then
		return
	end

	--------------------------------------------------
	-- DISTANCE
	--------------------------------------------------

	local Distance =
		(LocalRoot.Position - EnemyRoot.Position).Magnitude

	if Distance > CLOSE_DISTANCE then
		return
	end

	--------------------------------------------------
	-- TRIGGER CREATIVE TRAP
	--------------------------------------------------

	LastTrigger = Now

	Transceiver:FireServer(
		"UseSkill",
		"Creative Trap"
	)
end)

--------------------------------------------------
-- GET BALL HOLDER
--------------------------------------------------

local function GetBallHolder()

	for _, Player in ipairs(Players:GetPlayers()) do

		if Player ~= LocalPlayer then

			local Character = Player.Character

			if Character then

				local Ball =
					Character:FindFirstChild("Ball")

				local BallObject =
					Ball and Ball:FindFirstChild("Ball")

				if BallObject then
					return Player, BallObject
				end
			end
		end
	end

	return nil, nil
end

--------------------------------------------------
-- TACKLE
--------------------------------------------------

local function TryTackle()

	if not TackleEnabled then
		return
	end

	--------------------------------------------------
	-- COOLDOWN
	--------------------------------------------------

	local Now = tick()

	if Now - LastTackle < TackleCooldown then
		return
	end

	--------------------------------------------------
	-- LOCAL CHARACTER
	--------------------------------------------------

	local Character = LocalPlayer.Character

	if not Character then
		return
	end

	local Root =
		Character:FindFirstChild("HumanoidRootPart")

	if not Root then
		return
	end

	--------------------------------------------------
	-- LOCAL IFRAME
	--------------------------------------------------

	if HasIFrames(Character) then
		return
	end

	--------------------------------------------------
	-- FIND BALL HOLDER
	--------------------------------------------------

	local Holder, Ball = GetBallHolder()

	if not Holder or not Ball then
		return
	end

	--------------------------------------------------
	-- PREDICT BALL
	--------------------------------------------------

	local BallPosition = Ball.Position
	local Velocity = Ball.AssemblyLinearVelocity

	local PredictedPosition =
		BallPosition + Velocity * PREDICTION_TIME

	--------------------------------------------------
	-- DISTANCE
	--------------------------------------------------

	local Distance =
		(Root.Position - PredictedPosition).Magnitude

	if Distance > TACKLE_RANGE then
		return
	end

	--------------------------------------------------
	-- HOLDER IFRAME
	--------------------------------------------------

	local HolderCharacter = Holder.Character

	if HasIFrames(HolderCharacter) then
		return
	end

	--------------------------------------------------
	-- TACKLE
	--------------------------------------------------

	LastTackle = Now

	SkillEvent:FireServer(
		"TackleBegin"
	)

	task.wait()

	--------------------------------------------------
	-- FINAL IFRAME CHECK
	--------------------------------------------------

	if HasIFrames(HolderCharacter) then
		return
	end

	SkillEvent:FireServer(
		"Tackle",
		Ball,
		Root.CFrame * CFrame.new(0, -1.5, 0)
	)
end

--------------------------------------------------
-- TACKLE LOOP
--------------------------------------------------

task.spawn(function()

	while _G.TrapTackleHubRunning do

		TryTackle()

		task.wait(CHECK_INTERVAL)
	end
end)

