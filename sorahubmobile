--------------------------------------------------
-- BUTTON UPDATES
--------------------------------------------------

local function UpdateTrapButton()
	TrapButton.Text = "Trap: " .. (TrapEnabled and "ON" or "OFF")
end

local function UpdateTackleButton()
	TackleButton.Text = "Tackle: " .. (TackleEnabled and "ON" or "OFF")
end

local function UpdateAutoBikeButton()
	AutoBikeButton.Text = "Auto Bike: " .. (AutoBikeEnabled and "ON" or "OFF")
end

--------------------------------------------------
-- BUTTON INPUT
--------------------------------------------------

TrapButton.MouseButton1Click:Connect(function()
	TrapEnabled = not TrapEnabled
	UpdateTrapButton()
end)

TackleButton.MouseButton1Click:Connect(function()
	TackleEnabled = not TackleEnabled
	UpdateTackleButton()
end)

AutoBikeButton.MouseButton1Click:Connect(function()
	AutoBikeEnabled = not AutoBikeEnabled
	AutoBikeArmed = false
	UpdateAutoBikeButton()
end)

--------------------------------------------------
-- KEYBOARD
--------------------------------------------------

UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then
		return
	end

	--------------------------------------------------
	-- TOGGLES
	--------------------------------------------------

	if input.KeyCode == Enum.KeyCode.F2 then
		TrapEnabled = not TrapEnabled
		UpdateTrapButton()
		return
	end

	if input.KeyCode == Enum.KeyCode.F3 then
		TackleEnabled = not TackleEnabled
		UpdateTackleButton()
		return
	end

	if input.KeyCode == Enum.KeyCode.F4 then
		AutoBikeEnabled = not AutoBikeEnabled
		AutoBikeArmed = false
		UpdateAutoBikeButton()
		return
	end

	--------------------------------------------------
	-- AUTO BIKE SLOT
	--------------------------------------------------

	if AutoBikeEnabled then
		local ImpactKey = GetImpactBicycleKey()

		if ImpactKey and input.KeyCode == ImpactKey then
			AutoBikeArmed = true
			return
		end
	end

	--------------------------------------------------
	-- AUTO BIKE LMB
	--------------------------------------------------

	if AutoBikeEnabled
		and AutoBikeArmed
		and input.UserInputType == Enum.UserInputType.MouseButton1 then

		AutoBikeArmed = false
		UseImpactBicycle()
	end
end)

--------------------------------------------------
-- IFRAME CHECK
--------------------------------------------------

local function HasIFrames(Character)
	if not Character then
		return false
	end

	return Character:FindFirstChild("IFrames") ~= nil
		or Character:FindFirstChild("SuperIFrames") ~= nil
end

--------------------------------------------------
-- TRAP SYSTEM
--------------------------------------------------

Transceiver.OnClientEvent:Connect(function(
	Action,
	Player,
	Style,
	Skill,
	Ball
)

	if not TrapEnabled then
		return
	end

	if Action ~= "Hold" then
		return
	end

	if Player == LocalPlayer then
		return
	end

	if Skill ~= "Impact Shot"
		and Skill ~= "Explosive Kick" then
		return
	end

	local now = tick()

	if now - LastTrigger < TrapCooldown then
		return
	end

	local Character = LocalPlayer.Character

	if not Character then
		return
	end

	local LocalRoot = Character:FindFirstChild("HumanoidRootPart")
	local EnemyCharacter = Player.Character
	local EnemyRoot = EnemyCharacter
		and EnemyCharacter:FindFirstChild("HumanoidRootPart")

	if not LocalRoot or not EnemyRoot then
		return
	end

	local Distance = (
		LocalRoot.Position - EnemyRoot.Position
	).Magnitude

	if Distance > CLOSE_DISTANCE then
		return
	end

	if HasIFrames(Character) then
		return
	end

	LastTrigger = now

	Transceiver:FireServer(
		"UseSkill",
		"Creative Trap"
	)
end)

--------------------------------------------------
-- GET BALL HOLDER
--------------------------------------------------

local function GetBallHolder()
	for _, Player in ipairs(Players:GetPlayers()) do
		if Player ~= LocalPlayer then
			local Character = Player.Character

			if Character then
				local Ball = Character:FindFirstChild("Ball")
				local BallObject = Ball
					and Ball:FindFirstChild("Ball")

				if BallObject then
					return Player, BallObject
				end
			end
		end
	end

	return nil, nil
end

--------------------------------------------------
-- TACKLE
--------------------------------------------------

local function TryTackle()
	if not TackleEnabled then
		return
	end

	local now = tick()

	if now - LastTackle < TackleCooldown then
		return
	end

	local Character = LocalPlayer.Character

	if not Character then
		return
	end

	local Root = Character:FindFirstChild("HumanoidRootPart")

	if not Root then
		return
	end

	if HasIFrames(Character) then
		return
	end

	local Holder, Ball = GetBallHolder()

	if not Holder or not Ball then
		return
	end

	local BallPosition = Ball.Position

	local Velocity = Ball.AssemblyLinearVelocity

	local PredictedPosition =
		BallPosition + Velocity * PREDICTION_TIME

	local Distance = (
		Root.Position - PredictedPosition
	).Magnitude

	if Distance > TACKLE_RANGE then
		return
	end

	local HolderCharacter = Holder.Character

	if HasIFrames(HolderCharacter) then
		return
	end

	LastTackle = now

	SkillEvent:FireServer("TackleBegin")

	task.wait()

	if HasIFrames(HolderCharacter) then
		return
	end

	SkillEvent:FireServer(
		"Tackle",
		Ball,
		Root.CFrame * CFrame.new(0, -1.5, 0)
	)
end

--------------------------------------------------
-- TACKLE LOOP
--------------------------------------------------

task.spawn(function()
	while _G.TrapTackleHubRunning do
		TryTackle()
		task.wait(CHECK_INTERVAL)
	end
end)

